<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gutopardini.wayshot</id>
  <name>WayShot</name>
  <summary>GNOME/Wayland screenshot and annotation tool</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.gutopardini">
    <name>Guto Pardini</name>
  </developer>
  <description>
    <p>
      WayShot is a fast, minimal screenshot and annotation tool inspired by Flameshot.
      It is designed and supported only for GNOME running on Wayland.
    </p>
  </description>
  <launchable type="desktop-id">io.github.gutopardini.wayshot.desktop</launchable>
  <url type="homepage">https://github.com/gutopardini/wayshot</url>
  <url type="bugtracker">https://github.com/gutopardini/wayshot/issues</url>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <screenshots>
    <screenshot type="default">
      <caption>Main editor interface in dark mode</caption>
      <image>https://raw.githubusercontent.com/gutopardini/wayshot/main/data/screenshots/dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Main editor interface in light mode</caption>
      <image>https://raw.githubusercontent.com/gutopardini/wayshot/main/data/screenshots/light.png</image>
    </screenshot>
  </screenshots>
  <provides>
    <binary>wayshot</binary>
  </provides>
  <releases>
    <release version="0.1.5" date="2026-05-29">
      <description>
        <ul>
          <li>Update application screenshots for Flathub</li>
        </ul>
      </description>
    </release>
    <release version="0.1.4" date="2026-05-28">
      <description>
        <ul>
          <li>Implement persistent drawing settings (stroke size and color)</li>
          <li>Settings are now saved automatically and remembered across sessions</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2026-05-27">
      <description>
        <ul>
          <li>Add wl-clipboard dependency to fix copy-on-close issues</li>
          <li>Update documentation and Flathub branding</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-05-19" />
    <release version="0.1.1" date="2026-05-18" />
    <release version="0.1.0" date="2026-05-16" />
  </releases>
</component>
